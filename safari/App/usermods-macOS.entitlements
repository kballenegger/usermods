<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The host app reads no files, opens no sockets and talks to no other process. It draws one
	     window and asks Safari to show its extension settings, which needs nothing beyond the
	     sandbox itself. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
