#include "Shared.xcconfig"

// The host app. A Safari web extension cannot be installed on its own on either platform: it ships
// inside an app, and the app's job is to tell you where the switch is. On macOS it can do slightly
// better than that and open the switch for you. See safari/App/ViewController.swift and
// safari/App/MacViewController.swift.
PRODUCT_NAME = usermods
PRODUCT_BUNDLE_IDENTIFIER = $(USERMODS_BUNDLE_ID)
INFOPLIST_FILE = App/Info.plist
INFOPLIST_FILE[sdk=macosx*] = App/Info-macOS.plist

// Signed, sandboxed and hardened on the Mac. Safari will not load an extension out of an unsigned
// app bundle, and the sandbox is what an eventual notarised build needs, so the local build uses
// the same shape rather than a looser one that works here and fails later.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = App/usermods-macOS.entitlements
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
COMBINE_HIDPI_IMAGES[sdk=macosx*] = YES

// The app icon, from App/Assets.xcassets, on both platforms.
//
// This was empty for a while, and the reason is worth keeping: an app icon has to go through an
// asset catalog, and compiling one needs actool, which on the toolchain this branch was first
// built with (Xcode 15.4 on macOS 26) could not spawn its AssetCatalogSimulatorAgent — "Failed to
// launch AssetCatalogSimulatorAgent via CoreSimulator spawn", which fails the whole xcodebuild.
// Committing a catalog would have broken the build on the only machine that could run it, so the
// app shipped with the system placeholder instead. On Xcode 27 actool compiles both the
// iphonesimulator and the macosx platforms without complaint, so the catalog is in.
//
// The catalog is generated, not hand-exported: `node scripts/render-app-icon.mjs` renders it from
// assets/icon.svg and refuses to write a raster containing any colour the source artwork does not
// have, which is how a silently interpolated (mushy) pixel-art icon is kept out. iOS gets one
// full-bleed 1024 and the system masks it; macOS gets the ten (size, scale) slots it asks for,
// inset inside a margin the way a Mac icon is expected to be. test/safari-mac.test.ts pins the
// wiring, since a missing icon is invisible in a build log.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
