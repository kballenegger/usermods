{
  "name": "usermods",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe-code userscripts in place. Customize any website by chatting with any LLM.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:store": "USERMODS_STORE=1 wxt build",
    "zip": "wxt zip",
    "zip:store": "USERMODS_STORE=1 wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "postinstall": "wxt prepare",
    "screenshots": "wxt build && node scripts/screenshots.mjs",
    "smoke": "wxt build && node scripts/screenshots.mjs --smoke",
    "smoke:chats": "wxt build && node scripts/screenshots.mjs --chats",
    "smoke:isolation": "wxt build && node scripts/screenshots.mjs --isolation",
    "smoke:compaction": "wxt build && node scripts/screenshots.mjs --compaction",
    "smoke:dashboard": "wxt build && node scripts/screenshots.mjs --dashboard",
    "smoke:theme": "wxt build && node scripts/screenshots.mjs --theme",
    "smoke:tabbar": "wxt build && node scripts/screenshots.mjs --tabbar",
    "smoke:wait": "wxt build && node scripts/screenshots.mjs --wait",
    "store-assets": "wxt build && node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "acorn": "^8.18.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "wxt": "^0.21.4"
  }
}
